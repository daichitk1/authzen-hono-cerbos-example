{
  "name": "@authzen-demo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @authzen-demo/contracts build && pnpm --filter @authzen-demo/domain build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm --filter @authzen-demo/contracts build && pnpm --filter @authzen-demo/domain build",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "pnpm --filter @authzen-demo/contracts build && pnpm --filter @authzen-demo/domain build",
    "typecheck": "tsc --noEmit",
    "pretest:unit": "pnpm --filter @authzen-demo/contracts build && pnpm --filter @authzen-demo/domain build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@authzen-demo/contracts": "workspace:*",
    "@authzen-demo/domain": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

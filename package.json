{
  "name": "authzen-hono-cerbos-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @authzen-demo/web dev",
    "dev:api": "pnpm --filter @authzen-demo/api dev",
    "build:packages": "pnpm --filter @authzen-demo/contracts build && pnpm --filter @authzen-demo/domain build",
    "cerbos:up": "docker compose up -d --wait cerbos",
    "cerbos:down": "docker compose down --remove-orphans",
    "cerbos:logs": "docker compose logs cerbos",
    "cerbos:compile": "docker compose run --rm --no-deps cerbos compile /policies",
    "test:cerbos": "vitest run tests/cerbos-authzen.integration.test.ts",
    "test:integration": "pnpm build:packages && vitest run tests/hono-cerbos.integration.test.ts tests/pdp-errors.integration.test.ts",
    "test:fail-closed": "pnpm build:packages && vitest run tests/pdp-stopped.integration.test.ts",
    "test:e2e": "playwright test",
    "check:cerbos": "pnpm cerbos:compile && pnpm test:cerbos",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:public": "node scripts/check-public-content.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:code": "eslint . --max-warnings=0",
    "lint:docs": "markdownlint-cli2",
    "lint": "pnpm lint:code && pnpm lint:docs",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test:unit": "pnpm build:packages && pnpm -r --if-present test:unit",
    "build": "pnpm -r --if-present build",
    "check:fast": "pnpm format:check && pnpm lint && pnpm check:docs && pnpm check:public && pnpm typecheck && pnpm test:unit",
    "check": "pnpm check:fast && pnpm build && pnpm docs:build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "10.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10",
    "vitepress": "1.6.4"
  }
}
